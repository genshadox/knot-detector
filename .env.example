UID=1000                                    # user ID for the container user
GID=1000                                    # group ID for the container user
LOG_DIR_PATH=path/to/logs                   # path to an existing logs directory on the host machine
INPUT_DIR_PATH=path/to/input                # path to an existing input directory on the host machine
OUTPUT_DIR_PATH=path/to/output              # path to an existing output directory on the host machine
TEST_DIR_PATH=path/to/output_test           # path to an existing output_test directory on the host machine
MODE=test|infer                             # mode of operation: 'test' for testing, 'infer' for inference, defaults to 'infer'
CLEANUP=true|false                          # clean up previous results from inference or test, defaults to true